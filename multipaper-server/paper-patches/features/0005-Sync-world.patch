Subject: [PATCH] Sync world


diff --git a/src/main/java/io/papermc/paper/world/migration/WorldFolderMigration.java b/src/main/java/io/papermc/paper/world/migration/WorldFolderMigration.java
index 77fb09a15bcefaeb5016fcda53cd6a0c9e604ef8..cdaf43e3b5dea26427d22d6e883ae2b5ac7998d3 100644
--- a/src/main/java/io/papermc/paper/world/migration/WorldFolderMigration.java
+++ b/src/main/java/io/papermc/paper/world/migration/WorldFolderMigration.java
@@ -39,6 +39,7 @@ public final class WorldFolderMigration {
         final ResourceKey<LevelStem> stemKey,
         final ResourceKey<Level> dimensionKey
     ) throws IOException {
+        if (true) return; // MultiPaper - Sync world
         final WorldMigrationContext context = new WorldMigrationContext(rootAccess, registryAccess, worldName, stemKey, dimensionKey);
         final MigrationMode mode = classifyStartupMigration(context);
         if (mode != MigrationMode.NO_OP) {
@@ -58,6 +59,7 @@ public final class WorldFolderMigration {
         final ResourceKey<LevelStem> stemKey,
         final ResourceKey<Level> dimensionKey
     ) throws IOException {
+        if (true) return; // MultiPaper - Sync world
         LegacyCraftBukkitWorldMigration.migrateApiWorld(new WorldMigrationContext(rootAccess, registryAccess, worldName, stemKey, dimensionKey));
     }
 
diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index 18a700c8fff2a6cdaa29722fbcba258d94ea98d6..3be0dfb63983baec57110581dfe747791235b8b4 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -1486,6 +1486,7 @@ public final class CraftServer implements Server {
             return;
         }
         this.worlds.put(world.getName().toLowerCase(Locale.ROOT), world);
+        puregero.multipaper.MultiPaper.broadcastPacketToExternalServers(new puregero.multipaper.externalserverprotocol.SubscribeToWorldPacket(world.getUID())); // MultiPaper - Sync world
     }
 
     @Override
diff --git a/src/main/java/org/bukkit/craftbukkit/CraftWorld.java b/src/main/java/org/bukkit/craftbukkit/CraftWorld.java
index d67ef9e5b334ad107573fba224537b2b7c0db865..c17770bef41f13e253e99bc7c1011af5b59cd0a6 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftWorld.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftWorld.java
@@ -830,6 +830,7 @@ public class CraftWorld extends CraftRegionAccessor implements World {
 
         // Updates the clock for all players
         this.world.clockManager().setTotalTicks(this.world.dimensionType().defaultClock().get(), currentClockTime + event.getSkipAmount());
+        puregero.multipaper.MultiPaper.broadcastPacketToExternalServers(new puregero.multipaper.externalserverprotocol.TimeUpdatePacket(this.world, true)); // MultiPaper - Sync world
     }
 
     // Paper start
diff --git a/src/main/java/org/bukkit/craftbukkit/event/CraftEventFactory.java b/src/main/java/org/bukkit/craftbukkit/event/CraftEventFactory.java
index f3fd610c520dfe4b854a0cca7df0f4e3e1ef0da2..350f3f24ae91f46b51f6c72377993ae4fb2bced8 100644
--- a/src/main/java/org/bukkit/craftbukkit/event/CraftEventFactory.java
+++ b/src/main/java/org/bukkit/craftbukkit/event/CraftEventFactory.java
@@ -2344,6 +2344,7 @@ public class CraftEventFactory {
                 value = rule.deserialize(event.getValue()).getOrThrow(); // should never throw value is checked in the event
             }
             level.getGameRules().set(rule, value, level);
+            puregero.multipaper.externalserverprotocol.GameRuleUpdatePacket.onGameRuleChange(event.getWorld().getUID(), event.getGameRule().getName(), event.getValue()); // MultiPaper - Sync world
             return new GameRuleSetResult<>(value, false);
         } else {
             return new GameRuleSetResult<>(level.getGameRules().get(rule), true);
